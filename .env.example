# Copy this file to .env.local and fill in your private values.
# Keep this file server-only; do not add NEXT_PUBLIC_ to any of these names.

# --- MongoDB (inquiries + job applications) ---
# Create a database user in Atlas with read/write on the horinlife database.
# Copy the connection string from Atlas (Cluster -> Connect -> Connect your application).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/horinlife?retryWrites=true&w=majority
# Database name. Defaults to "horinlife" in code if left blank.
MONGODB_DB=horinlife

# --- Resend (email notifications) ---
# Get a key at https://resend.com/api-keys and verify the sender domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Must match a verified domain in your Resend account.
RESEND_FROM_EMAIL=Horin Life <notifications@horinlife.com>
# Where inquiry submissions are emailed to.
INQUIRY_NOTIFICATION_EMAIL=info.horinlife@gmail.com
# Where job applications (with CV) are emailed to.
CAREER_NOTIFICATION_EMAIL=info.horinlife@gmail.com