# Copy this file to .env.local and fill in your private values.
# Keep this file server-only; do not add NEXT_PUBLIC_ to any of these names.

# MongoDB Atlas connection string for the application database user.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/horinlife?retryWrites=true&w=majority
MONGODB_DB=horinlife

# Resend email notifications. Verify the sender domain in Resend before using it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Horin Life <notifications@horinlife.com>
INQUIRY_NOTIFICATION_EMAIL=info.horinlife@gmail.com
CAREER_NOTIFICATION_EMAIL=info.horinlife@gmail.com
