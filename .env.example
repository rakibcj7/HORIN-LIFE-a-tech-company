# MongoDB Atlas connection string. Keep credentials server-side; never use NEXT_PUBLIC_ here.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/horinlife?retryWrites=true&w=majority
MONGODB_DB=horinlife

# Optional email notification via Resend. Verify the sender domain in Resend first.
RESEND_API_KEY=
INQUIRY_NOTIFICATION_EMAIL=inquiries@example.com
RESEND_FROM_EMAIL=HORIN LIFE <inquiries@example.com>
